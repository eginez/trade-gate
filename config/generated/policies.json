{
  "permits": [
    {
      "id": "p1",
      "action": "get_account_numbers",
      "method": "GET",
      "path": "/trader/v1/accounts/accountNumbers"
    },
    {
      "id": "p2",
      "action": "get_account",
      "method": "GET",
      "path": "/trader/v1/accounts/{hash}"
    },
    {
      "id": "p3",
      "action": "list_orders",
      "method": "GET",
      "path": "/trader/v1/accounts/{hash}/orders"
    },
    {
      "id": "p4",
      "action": "get_order",
      "method": "GET",
      "path": "/trader/v1/accounts/{hash}/orders/{orderId}"
    },
    {
      "id": "p5",
      "action": "get_quote",
      "method": "GET",
      "path": "/marketdata/v1/quotes"
    },
    {
      "id": "p6",
      "action": "preview_order",
      "method": "POST",
      "path": "/trader/v1/accounts/{hash}/previewOrder",
      "body": {
        "session": "NORMAL",
        "duration": "DAY",
        "orderTypes": [
          "MARKET",
          "LIMIT"
        ],
        "orderStrategyType": "SINGLE",
        "instruction": "BUY",
        "assetTypes": [
          "EQUITY",
          "ETF"
        ]
      }
    },
    {
      "id": "p7",
      "action": "place_order",
      "method": "POST",
      "path": "/trader/v1/accounts/{hash}/orders",
      "body": {
        "session": "NORMAL",
        "duration": "DAY",
        "orderTypes": [
          "MARKET",
          "LIMIT"
        ],
        "orderStrategyType": "SINGLE",
        "instruction": "BUY",
        "assetTypes": [
          "EQUITY",
          "ETF"
        ]
      },
      "maxDollars": 1000
    }
  ]
}
