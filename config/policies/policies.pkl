// policies.pkl — config/data ONLY. The schema is in
// config/schemas/PolicySet.pkl; this file just fills it in.
//
// Exactly 7 permits, one per allowed action. Everything else is
// automatically forbidden by deny-by-default — there is NO forbids
// list in this file, and none is needed.
//
// Render with:
//   pkl eval policies.pkl -f json > ../generated/policies.json

amends "../schemas/PolicySet.pkl"

permits = new {
  new {
    id = "p1"
    action = "get_account_numbers"
    method = "GET"
    path = "/trader/v1/accounts/accountNumbers"
  }
  new {
    id = "p2"
    action = "get_account"
    method = "GET"
    path = "/trader/v1/accounts/{hash}"
  }
  new {
    id = "p3"
    action = "list_orders"
    method = "GET"
    path = "/trader/v1/accounts/{hash}/orders"
  }
  new {
    id = "p4"
    action = "get_order"
    method = "GET"
    path = "/trader/v1/accounts/{hash}/orders/{orderId}"
  }
  new {
    id = "p5"
    action = "get_quote"
    method = "GET"
    path = "/marketdata/v1/quotes"
  }
  new {
    id = "p6"
    action = "preview_order"
    method = "POST"
    path = "/trader/v1/accounts/{hash}/previewOrder"
    body = new {
      session = "NORMAL"
      duration = "DAY"
      orderTypes = new { "MARKET" "LIMIT" }
      orderStrategyType = "SINGLE"
      instruction = "BUY"
      assetTypes = new { "EQUITY" "ETF" }
    }
  }
  new {
    id = "p7"
    action = "place_order"
    method = "POST"
    path = "/trader/v1/accounts/{hash}/orders"
    // EXAMPLE ONLY — not a decision. Adjust in this file.
    maxDollars = 1000
    body = new {
      session = "NORMAL"
      duration = "DAY"
      orderTypes = new { "MARKET" "LIMIT" }
      orderStrategyType = "SINGLE"
      instruction = "BUY"
      assetTypes = new { "EQUITY" "ETF" }
    }
  }
}
