load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "trade-gate-proxy",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    deps = [
        "@crates//:bytes",
        "@crates//:http-body-util",
        "@crates//:hyper",
        "@crates//:hyper-rustls",
        "@crates//:hyper-util",
        "@crates//:pingora",
        "@crates//:rusqlite",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
    data = ["//:generated_config"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "trade_gate_proxy_test",
    crate = ":trade-gate-proxy",
    # The test module uses include_str! on the generated JSON, which is
    # resolved at COMPILE time: the files must be compile inputs, not
    # just runtime data (data = runfiles only, invisible to rustc).
    compile_data = ["//:generated_config"],
    data = ["//:generated_config"],
)
