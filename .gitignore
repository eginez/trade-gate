# Build outputs, local state, secrets — never commit these.
# (Cargo.lock is deliberately NOT ignored: Bazel's crate_universe
# reads it, and a binary repo commits its lockfile.)
/target/
# Bazel output symlinks created by `bazel build` in the workspace root.
# (MODULE.bazel.lock is deliberately NOT ignored: it pins module
# versions for reproducible builds.)
/bazel-*
*.db
*.db-journal
__pycache__/
*.pyc
.env
*.pem
*.key
.DS_Store
# Demo — local only, never pushed. The demo script and its
# recordings (.cast, .gif) live here for the owner, not the repo.
demo/
docker/demo/
