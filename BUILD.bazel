# Root BUILD.bazel: the generated Pkl JSON is a checked-in data
# dependency of the proxy, and the Pkl sources are the source of
# truth for it.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

filegroup(
    name = "generated_config",
    srcs = [
        "config/generated/allowlist.json",
        "config/generated/policies.json",
    ],
    visibility = ["//visibility:public"],
)

# Re-render check: when `pkl` is available, the rendered JSON must
# match the checked-in files. Run with `bazel test //:check_generated`.
#
# The script source is NOT executable in the repo as pushed (the
# snapshot push does not preserve file modes), and sh_test requires an
# executable src. So a genrule copies it and chmods the copy; the
# test runs the generated file, not the source.
genrule(
    name = "check_generated_sh",
    srcs = ["tools/check-generated.sh"],
    outs = ["check-generated.sh"],
    cmd = "cp $(location tools/check-generated.sh) $@ && chmod +x $@",
)

sh_test(
    name = "check_generated",
    srcs = [":check_generated_sh"],
    data = [
        "config/generated/allowlist.json",
        "config/generated/policies.json",
        "config/policies/allowlist.pkl",
        "config/policies/policies.pkl",
    ],
)
